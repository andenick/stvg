# STVG — example environment configuration
#
# Copy to `.env` and edit. Nothing here is required to play locally: every
# variable has a working default, and no API keys, accounts or paid services
# are involved. `.env` itself is git-ignored; only this example is committed.
#
# Note: the values are read from the *process environment*, not from this file
# directly. Export them in your shell (or set them in your container /
# service definition) before starting the server or the telemetry script.
#   PowerShell:  $env:STVG_MAX_SESSIONS = '4'
#   bash/zsh:    export STVG_MAX_SESSIONS=4

# ── Game server runtime (stvg_server, read by RuntimeConfig::fromEnv) ────────

# Root directory for saves and telemetry. Created on first use.
# The shipped container image sets this to /var/lib/stvg.
STVG_DATA_DIR=./data-runtime

# Maximum concurrent game sessions the server will hold in memory.
STVG_MAX_SESSIONS=12

# Maximum concurrent sessions from a single client IP address.
STVG_PER_IP_CAP=3

# Seconds of inactivity after which an idle session is evicted (default 30 min).
STVG_IDLE_EVICT_SECONDS=1800

# Seconds between housekeeping sweeps (eviction, gzip, retention).
STVG_SWEEP_INTERVAL_SECONDS=60

# ── Telemetry pull script (pull_telemetry.ps1) ───────────────────────────────
# Only needed if you run your own remote deployment and want to pull its
# telemetry down to this machine. Leave unset for local play.

# Hostname or IP of the machine running the serving container.
STVG_BOX_HOST=

# SSH user on that machine.
STVG_BOX_USER=

# Path to the SSH private key to authenticate with (default ~/.ssh/id_ed25519).
STVG_SSH_KEY=

# Name of the container serving the game on that machine.
STVG_CONTAINER=
